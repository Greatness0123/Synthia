# SYNTHIA Environment Configuration
# Copy this file to .env and fill in the values you need.
# These variables are ONLY for the optional serverless inference proxies (api/infer/).
# The main application (src/) does not require any environment variables to run locally.

# ---------------------------------------------------------------------------
# Serverless Proxy Security
# ---------------------------------------------------------------------------
# Shared secret checked against incoming proxy requests (x-synthia-secret header).
# Set this to a long, random string in your deployment environment.
SYNTHIA_SHARED_SECRET=

# ---------------------------------------------------------------------------
# AI Provider API Keys (Server-Side Only)
# ---------------------------------------------------------------------------
# These are used by the Vercel Edge functions to proxy requests, keeping keys
# out of the browser. Configure the ones you plan to use.
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
NVIDIA_NIM_API_KEY=
DASHSCOPE_API_KEY=
CEREBRAS_API_KEY=
MINIMAX_API_KEY=
MOONSHOT_API_KEY=
MISTRAL_API_KEY=
NVIDIA_API_KEY=
XAI_API_KEY=
ZAI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
TOGETHER_API_KEY=
FIREWORKS_API_KEY=
HF_API_KEY=
