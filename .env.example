# SYNTHIA Environment Configuration
# Copy this file to .env and fill in the values you need.
# These variables are ONLY for the optional serverless inference proxies in api/infer/.
# The main application in src/ does not require environment variables to run locally.

# ---------------------------------------------------------------------------
# Serverless Proxy Security
# ---------------------------------------------------------------------------
# Shared secret checked against incoming proxy requests (x-synthia-secret header).
# Set this to a long random string in your deployment environment.
SYNTHIA_SHARED_SECRET=

# ---------------------------------------------------------------------------
# AI Provider API Keys (Server-Side Only)
# ---------------------------------------------------------------------------
# These are used by the edge functions to proxy requests and keep keys out of the browser.
# Configure only the providers you plan to use.
# Supported providers in api/infer/openai-compat.ts and api/infer/gemini.ts:
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
NVIDIA_NIM_API_KEY=
DASHSCOPE_API_KEY=
CEREBRAS_API_KEY=
MINIMAX_API_KEY=
MOONSHOT_API_KEY=
MISTRAL_API_KEY=
NVIDIA_API_KEY=
XAI_API_KEY=
ZAI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
TOGETHER_API_KEY=
FIREWORKS_API_KEY=
HF_API_KEY=

# Optional note:
# - The app core does not read these values at runtime unless you are using the proxy endpoints.
# - Match the provider names you send in the x-provider-id header or provider query/body field.
# - Example provider IDs supported by the compat proxy: groq, openrouter, nim, qwen, cerebras,
#   minimax, moonshot, mistral, nvidia, xai, zai, anthropic, openai, deepseek,
#   together, fireworks, huggingface.
