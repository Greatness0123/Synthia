FROM node:20-alpine

WORKDIR /app

# Install dependencies
COPY package.json package-lock.json ./
RUN npm install

# Copy application source
COPY . .

# Expose Vite dev server port
EXPOSE 5173

# Start Vite with host binding for Docker port forwarding
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0", "--port", "5173"]
